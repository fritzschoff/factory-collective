# Image slots: local (own files, else sample pictures) · strict (own files only) · placeholders (none)
IMAGES=local
# Public address of the site — canonical URLs and sitemap
SITE_URL=http://localhost:3000
# Plausible prices for previews; never in production
DEMO_PRICES=0
# Base URL of the Firebase Functions. Empty: forms and checkout say "… is not connected yet."
# Local emulators: http://127.0.0.1:5001/<project>/europe-west3
NEXT_PUBLIC_API_BASE=
# Firebase web config for the admin login. Public values; the project id is not committed elsewhere.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to 1 so the admin login talks to the local Auth and Functions emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
# Optional override for scripts/firebase-project.mjs. Defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Service account for seeding the real project. Never commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Function parameters (defaults live in the code; set them in Firebase for production):
# SITE_URL, ALLOWED_ORIGINS, SHIPPING_COUNTRIES, STRIPE_SHIPPING_RATES, STRIPE_AUTOMATIC_TAX, ENQUIRY_TO, MAIL_FROM
# Secrets, only in functions/.secret.local or Secret Manager: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY
