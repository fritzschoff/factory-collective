{
  "name": "cfc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Concept. ( Factory ) Collective — website",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:placeholders": "IMAGES=placeholders node scripts/build.mjs",
    "start": "node dist-server/server.mjs",
