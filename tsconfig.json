{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@cfc/shop-core": ["./packages/shop-core/src/index.ts"],
      "@cfc/shop-core/sku": ["./packages/shop-core/src/sku.ts"],
      "@cfc/shop-core/price": ["./packages/shop-core/src/price.ts"],
      "@cfc/shop-core/validate": ["./packages/shop-core/src/validate.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "functions", "packages"]
}
